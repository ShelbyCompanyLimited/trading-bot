# Stock Configuration: TSLA (Tesla Inc.)
# High volatility stock - requires different parameters
# This config is used for both live trading and backtesting

# Stock Information
stock:
  symbol: "TSLA"            # Stock symbol (must match filename)
  enabled: true             # Enable/disable trading for this stock
  description: "Tesla Inc."

# Backtesting Configuration
backtest:
  enabled: true             # Enable backtesting for this stock
  
  # Date Range
  start_date: "2024-01-01"  # Start date for backtest
  end_date: "2024-12-31"    # End date for backtest
  
  # Timeframe (shorter for volatile stocks)
  timeframe: "15 min"       # Bar size: "1 min", "5 min", "15 min", "1 hour", "4 hour", "1 day"
  
  # Data Source
  data_source: "ib"         # "ib" for Interactive Brokers, "csv" for local files
  
  # CSV Data Source (if data_source = "csv")
  csv_settings:
    directory: "data/historical"
    file_format: "{symbol}_{timeframe}.csv"
    date_column: "date"
    price_columns:
      open: "open"
      high: "high"
      low: "low"
      close: "close"
      volume: "volume"
  
  # Commission and Slippage
  commission_per_trade: 1.0  # $1 per trade (round trip)
  slippage_percent: 0.001     # 0.1% slippage per trade
  
  # Output Settings
  generate_charts: true      # Generate visualization charts
  generate_report: true       # Generate HTML report
  save_trades: true          # Save trade data to CSV
  chart_format: "png"        # Chart format: "png", "html", "pdf"
  chart_library: "matplotlib" # "matplotlib" or "plotly" (for interactive)
  
  # Chart Settings
  charts:
    price_with_trades: true  # Price chart with entry/exit points
    equity_curve: true       # Account equity over time
    drawdown: true           # Drawdown chart
    trade_distribution: true  # P&L distribution
    monthly_returns: true     # Monthly returns
    strategy_analysis: true   # Strategy-specific analysis

# Break and Retest Strategy Configuration for this stock
strategy:
  name: "BreakAndRetestStrategy"
  
  # ============================================
  # Level Identification Parameters
  # ============================================
  
  lookback_period: 50        # Bars to look back for support/resistance levels
  min_touch_count: 2         # Minimum touches to qualify as S/R level
  level_tolerance: 0.008     # 0.8% tolerance (wider for volatile stock)
  min_level_strength: 0.6    # Higher minimum strength required
  
  # ============================================
  # Breakout Detection Parameters
  # ============================================
  
  break_threshold: 0.01      # 1% break required (higher for volatile TSLA)
  require_volume_confirmation: true
  volume_multiplier: 1.5     # Higher volume requirement (1.5x average)
  breakout_bars: 2           # Number of bars to confirm breakout
  
  # ============================================
  # Retest Parameters
  # ============================================
  
  retest_threshold: 0.015    # 1.5% retest zone (wider for volatility)
  max_retest_bars: 10        # Maximum bars to wait for retest
  retest_bounce_threshold: 0.005  # 0.5% bounce required (stronger bounce)
  
  # ============================================
  # Entry Parameters
  # ============================================
  
  min_confidence: 0.7        # Higher confidence required (0.7 = 70%)
  entry_on_bounce: true     # Enter on bounce from retest level
  entry_buffer: 0.003       # 0.3% buffer (larger for volatile stock)
  
  # ============================================
  # Exit Parameters
  # ============================================
  
  profit_target_multiplier: 2.0  # Higher target (2x risk) for volatile stock
  use_trailing_stop: true    # Use trailing stop for TSLA
  trailing_stop_percentage: 0.015  # 1.5% trailing stop

# Stock-Specific Risk Management
risk:
  max_risk_per_trade: 0.015  # Lower risk (1.5%) for volatile TSLA
  stop_loss_percentage: 0.03  # 3% stop loss (wider for volatility)

# Notes
# TSLA is highly volatile, so we use:
# - Higher break_threshold (1% vs 0.5%)
# - Higher min_confidence (0.7 vs 0.6)
# - Higher volume_multiplier (1.5x vs 1.2x)
# - Wider stop loss (3% vs 2%)
# - Trailing stop enabled
